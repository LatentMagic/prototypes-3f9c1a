      {
        "selector": "JSXOpeningElement[name.name='CardRow'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:cards|chat)$/]",
        "message": "<CardRow> kind must be one of 'cards' | 'chat'."
