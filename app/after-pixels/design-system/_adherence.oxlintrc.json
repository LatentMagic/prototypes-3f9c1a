{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "components/actions/**",
              "components/chat/**",
              "components/feedback/**",
              "components/forms/**",
              "components/media/**",
              "components/media/playback/**",
              "components/surfaces/**",
              "docs/archive/rows-and-history/playground/**",
              "docs/specs/canonical-row/playground/**",
              "docs/specs/card-chip-alignment/playground/**",
              "docs/specs/card-snug-title/playground/**",
              "ui_kits/shop/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Hanken Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|loading|loadingLabel|done|doneLabel|disabled|block|icon|type|onClick|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, loading, loadingLabel, done, doneLabel, disabled, block, icon, type, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:main|secondary|danger)$/]",
        "message": "<Button> variant must be one of 'main' | 'secondary' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:search|back|close|lock|play|settings)$/]",
        "message": "<Button> icon must be one of 'search' | 'back' | 'close' | 'lock' | 'play' | 'settings'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|children|className|style|href|onClick|label|chevron|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, action, children, className, style, href, onClick, label, chevron."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sub|label|as|kind|children|className|key|ref|className|style|children)$/]",
        "message": "<CardRow> doesn't accept that prop. Declared props: title, sub, label, as, kind, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardRow'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h2|h3)$/]",
        "message": "<CardRow> as must be one of 'h2' | 'h3'."
