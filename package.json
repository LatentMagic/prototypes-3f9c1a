{
  "name": "prototype-console",
  "private": true,
  "version": "0.1.0",
  "description": "Console for browsing LatentMagic prototypes (Circlists and others).",
  "scripts": {
    "start": "node server.js",
    "check": "node tools/check.js",
    "diff": "node tools/diff.js",
    "build:ds": "vite build --config app/after-pixels/design-system/vite.config.mjs",
    "build": "node tools/ap-names.mjs --check && vite build --config app/after-pixels/canon/vite.config.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@babel/parser": "7.29.0",
    "@babel/traverse": "7.29.0",
    "pixelmatch": "^5.3.0",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "vite": "6.4.5"
  }
}
